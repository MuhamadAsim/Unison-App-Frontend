{
  "expo": {
    "name": "unison",
    "slug": "unison",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-unison.png",
    "scheme": "unison",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon-unison.png",
        "backgroundImage": "./assets/images/icon-unison.png",
        "monochromeImage": "./assets/images/icon-unison.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.muhammadasimayub.unison"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon-unison.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon-unison.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "317e1c00-a14b-4b9e-80c2-d017f155b967"
      }
    },
    "owner": "asimayubs-organization"
  }
}
